@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenCV 4 COMPONENTS @MOT_OPENCV_COMPONENTS@)

set(MOT_WITH_TENSORRT @MOT_WITH_TENSORRT@)
if(MOT_WITH_TENSORRT)
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(CUDAToolkit)
    find_dependency(TensorRT)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/motTargets.cmake")
check_required_components(mot)
